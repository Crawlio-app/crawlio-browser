{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crawlio.app/semantic-grounding/provider.schema.json",
  "title": "SemanticGroundingProvider",
  "type": "object",
  "required": ["id", "kind", "modelVersion", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["ane", "onnx", "heuristic", "llm"]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["embed", "classify", "rerank", "ground", "reason"]
      }
    }
  }
}
