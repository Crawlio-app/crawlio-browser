{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crawlio.app/semantic-grounding/context.schema.json",
  "title": "GroundingContext",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "pageSnapshot": {
      "description": "Serialized page snapshot or structured accessibility/DOM capture generated by perception.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "frameworkState": {},
    "hydrationPayload": {},
    "networkObservations": {
      "type": "array",
      "items": {}
    },
    "apiObservations": {
      "type": "array",
      "items": {}
    },
    "candidateActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": true,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "name": { "type": "string" },
          "text": { "type": "string" },
          "selector": { "type": "string" },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
