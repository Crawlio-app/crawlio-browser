# Newly published versions must age before they can enter the lockfile. A compromised
# release is usually caught and unpublished within days, so waiting a week converts most
# supply-chain incidents into a non-event. Honored by npm >= 11.10.0; CI installs from the
# committed lockfile with `npm ci`, so it is unaffected. To take an urgent fix sooner,
# install that exact version explicitly.
min-release-age=7
